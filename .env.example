# ==============================================================================
# Domain Intelligence Layer (DIL) - Environment Configuration Example
# Copy this file to .env and replace the placeholder values with your real credentials:
#   copy .env.example .env   (Windows cmd / PowerShell)
#   cp .env.example .env     (Linux / macOS)
# ==============================================================================

# --- OpenAI Configuration ---
# Required for running the Streamlit demo and OpenAI callable
OPENAI_API_KEY=your_openai_api_key_here

# --- Google Gemini Configuration (Optional) ---
# Required only if using create_gemini_callable in dil.llm
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here
